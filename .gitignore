# Ignore direct root entries, then allow the project files and directories.
/*

# Directories
!/.github/
!/.vscode/
!/docs/
!/resources/
!/scripts/
!/src/
!/test/

# Files
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.node-version
!/.npmrc
!/.oxlintrc.json
!/.pre-commit-config.yaml
!/.vscodeignore
!/AGENTS.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/Justfile
!/License.txt
!/README.md
!/dprint.json
!/flake.lock
!/flake.nix
!/package-lock.json
!/package.json
!/package.nls.json
!/package.nls.zh-cn.json
!/webpack.config.js
!/tsconfig.json

# Keep local editor settings and generated files out of allowed directories.
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
node_modules/
dist/
out/
.direnv/
*.vsix
